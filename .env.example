# Copy this file to ".env" (project root) and fill in your values. ".env" is never committed to git.
# On Vercel: add the same keys in Project Settings -> Environment Variables (no .env file there).

# REQUIRED - MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MONGODB_DB_NAME="lahoti_costing_db"
# Set to false to keep all data in local files only (backend/storage) - local testing only
MONGODB_ENABLED="true"

# REQUIRED ON VERCEL - long random text that signs logins (only signed Admin logins can unlock prices).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Locally it may stay empty (a key is generated in backend/storage/auth_secret.key).
AUTH_SECRET=""

# OPTIONAL - Zoho CRM (https://api-console.zoho.com). Without these, quotes are recorded but no Zoho deal is created.
ZOHO_CLIENT_ID="YOUR_ZOHO_CLIENT_ID"
ZOHO_CLIENT_SECRET="YOUR_ZOHO_CLIENT_SECRET"
ZOHO_REFRESH_TOKEN="YOUR_ZOHO_REFRESH_TOKEN"
ZOHO_API_DOMAIN="www.zohoapis.com"
ZOHO_ACCOUNTS_DOMAIN="accounts.zoho.com"

# OPTIONAL
# DATA_DIR: local fallback storage folder (default backend/storage; /tmp on Vercel)
# DATA_DIR=""
# PORT: port used by "npm start" (production on your own server, default 8080)
# PORT="8080"
